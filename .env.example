# Environment variables for PolyLance deployment
# Copy this file to .env and fill in real values

# Deployer private key (no 0x prefix needed by some tools, with is fine here)
PRIVATE_KEY=0x...your_deployer_private_key...

# Polygon Amoy RPC URL — get one from Alchemy or Infura, or use the public endpoint
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygonscan API key — for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Bootstrap wallet addresses (used by scripts/bootstrap.ts)
BOOTSTRAP_ARBITRATOR_1=0x...first_arbitrator_address...
BOOTSTRAP_ARBITRATOR_2=0x...second_arbitrator_address...
SAFE_ADDRESS=0x...2_of_2_gnosis_safe_address...
ORACLE_SIGNING_ADDRESS=0x...oracle_hot_wallet_address...

# Pinata IPFS Upload Service configuration (server-side only)
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=your-gateway.mypinata.cloud

# AuditX Security Monitoring & Webhook configuration (server-side only)
AUDITX_API_URL=https://auditx.yourapp.com
AUDITX_API_KEY=ax_live_af4eb3795d5140878278cc82d01c3a6d
AUDITX_WEBHOOK_SECRET=sec_bc2d1ed617a54e36980b6381051a38c7
DISCORD_ADMIN_WEBHOOK_URL=your_discord_admin_webhook_url_here

# Enable gas reporting
# REPORT_GAS=true
