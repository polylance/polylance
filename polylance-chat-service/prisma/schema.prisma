datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ConversationKeyRegistry {
  jobAddress                String   @id
  clientAddress             String
  freelancerAddress         String
  encryptedKeyForClient     String
  encryptedKeyForFreelancer String
  deletionEligible          Boolean  @default(false)
  keyShredded               Boolean  @default(false)
  createdAt                 DateTime @default(now())
}

model MessageIndex {
  id            String   @id @default(uuid())
  jobAddress    String
  messageCid    String
  senderAddress String
  sentAt        DateTime @default(now())

  @@index([jobAddress])
}

model ProtocolSharedState {
  key       String   @id @default("global_state")
  data      Json
  updatedAt DateTime @updatedAt
}

model JobRecord {
  id              String   @id
  contractAddress String?
  client          String
  freelancer      String?
  status          String
  data            Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([client])
  @@index([freelancer])
}

model ProfileRecord {
  address   String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model AuditAlert {
  id               String   @id @default(uuid())
  alert_id         String   @unique
  contract_address String
  chain            String
  severity         String
  category         String
  title            String
  description      String
  detected_at      DateTime
  tx_hash          String?
  event_type       String?
  schema_version   String   @default("1.0.0")
  received_at      DateTime @default(now())
  status           String   @default("RECEIVED")

  @@index([contract_address])
  @@index([severity])
  @@index([detected_at])
}

model WebhookNonce {
  nonce     String   @id
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

